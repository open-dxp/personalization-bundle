name: "Trigger POEditor Translations Export"

on:
    workflow_dispatch:
    push:
        branches:
            - "[0-9]+.x"
        paths:
            - 'translations/admin.en.yaml'

permissions:
    contents: read

jobs:
    poeditor:
        runs-on: ubuntu-latest
        steps:
            -   name: Trigger workflow in opendxp/poeditor-export-action
                run: |
                    gh workflow run -R opendxp/poeditor-export-action poeditor-export.yaml
