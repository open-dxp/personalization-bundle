{
    "name": "open-dxp/personalization-bundle",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "description": "OpenDXP Personalization Bundle",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.1",
        "geoip2/geoip2": "^2.9",
        "symfony/stopwatch": "^7.4",
        "symfony/form": "^7.4",
        "lcobucci/jwt": "^4.0 || ^5.0",
        "matomo/device-detector": "^6.0",
        "open-dxp/newsletter-bundle": "^1.0",
        "colinmollenhour/credis": "^1.10.0",
        "mjaschen/phpgeo": "^4.0",
        "open-dxp/admin-bundle": "^1.0"
    },
    "require-dev": {
        "symfony/dotenv": "^7.3",
        "symfony/runtime": "^7.3",
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "codeception/codeception": "^5.3.5",
        "codeception/module-asserts": "^2",
        "codeception/module-symfony": "^3.1.1"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\PersonalizationBundle\\": "src/",
            "OpenDxp\\Model\\DataObject\\": "src/OpenDxp/Model/DataObject"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\PersonalizationBundle\\Tests\\": "tests"
        },
        "files": [
            "kernel/Kernel.php"
        ]
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\PersonalizationBundle\\OpenDxpPersonalizationBundle"
            ]
        }
    }
}
